{
  "name": "mathdown",
  "version": "1.2.0",
  "description": "Markdown editor with offline LaTeX rendering for Supernote",
  "private": true,
  "scripts": {
    "test": "node engine/test/run-tests.js && jest",
    "typecheck": "tsc --noEmit -p .",
    "build": "bash tools/build-plugin.sh",
    "build:gradle": "bash buildPlugin.sh",
    "icons": "node tools/make-icons.js",
    "icons:ui": "node tools/make-ui-icons.js"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "markdown-it": "14.1.0",
    "markdown-it-footnote": "4.0.0",
    "mathjax-full": "3.2.2",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "sn-plugin-lib": "0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheScholium/mathdown.git"
  },
  "homepage": "https://github.com/TheScholium/mathdown"
}
